# .renderignore
# Files to exclude from Render deployment

# Development files
node_modules/
.env
.env.local
.env.*.local

# Build files
dist/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
test/
coverage/
*.test.ts
*.test.js

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Git
.git/
.github/

# Documentation (optional - uncomment if you want to skip docs)
# docs/
# *.md
# !README.md

# Temporary files
uploads/temp/
*.tmp
